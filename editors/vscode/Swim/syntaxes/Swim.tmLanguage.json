{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swim",
  "scopeName": "source.Swim",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.Swim",
          "match": "//.*$"
        },
        {
          "name": "comment.block.Swim",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.multi.Swim",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-interpolation" },
            { "name": "constant.character.escape.Swim", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.Swim",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-interpolation" },
            { "name": "constant.character.escape.Swim", "match": "\\\\u\\{[0-9a-fA-F]+\\}|\\\\." }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.Swim",
          "begin": "\\\\\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.Swim" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.Swim" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.Swim",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.Swim",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.Swim",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.Swim",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.Swim",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.swift",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.Swim" },
            "2": { "name": "entity.name.function.Swim" }
          }
        },
        {
          "name": "meta.type.Swim",
          "match": "\\b(struct|class|enum|protocol|extension|typealias)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.Swim" },
            "2": { "name": "entity.name.type.Swim" }
          }
        },
        {
          "name": "meta.enum-case.Swim",
          "match": "\\bcase\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "keyword.control.Swim" },
            "1": { "name": "entity.name.function.Swim" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.Swim",
          "match": "\\b(if|else|guard|switch|case|default|for|in|while|repeat|break|continue|fallthrough|return|throw|defer|do|catch|try|where|is|as)\\b"
        },
        {
          "name": "keyword.other.Swim",
          "match": "\\b(func|init|deinit|struct|class|enum|protocol|extension|typealias|import|let|var|static|mutating|nonmutating|override|final|public|private|internal|fileprivate|open|required|convenience|lazy|weak|unowned|indirect|inout|throws|rethrows|async|await|subscript|willSet|didSet|get|set|operator|precedencegroup)\\b"
        },
        {
          "name": "constant.language.Swim",
          "match": "\\b(true|false|nil|self|super)\\b"
        },
        {
          "name": "constant.language.Swim",
          "match": "#(file|line|column|function)\\b"
        },
        {
          "name": "meta.preprocessor.Swim",
          "match": "^\\s*#(if|elseif|else|endif|error|warning|available|unavailable)\\b.*$"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.Swim",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Double|Float|Bool|String|Character|Void|Any|AnyObject|Never)\\b"
        },
        {
          "name": "support.type.Swim",
          "match": "\\b(Array|Dictionary|Set|Optional|Result)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.Swim",
          "match": "(==|!=|<=|>=|&&|\\|\\||\\?\\?|\\.\\.<|\\.\\.\\.|->|\\+=|-=|\\*=|/=|%=|<<=|>>=|=|\\+|-|\\*|/|%|<|>|!|&|\\||\\^|~|\\?|:)"
        }
      ]
    }
  }
}
